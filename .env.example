# Kano Streets Environment Variables Configuration
# Copy this file to .env and fill in your Neon PostgreSQL connection strings.
# Do NOT commit .env to source control (it is ignored by .gitignore).

# Neon PostgreSQL Pooled Connection (for normal application queries):
# e.g. postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/kano_streets?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@YOUR_ENDPOINT.neon.tech/neondb?sslmode=require

# Neon PostgreSQL Direct Unpooled Connection (optional, recommended for schema migrations):
# e.g. postgresql://[user]:[password]@[endpoint].[region].neon.tech/kano_streets?sslmode=require
DIRECT_URL=

